{
  "name": "@mdtbbs/resource-storage",
  "version": "0.1.0",
  "private": true,
  "description": "MDTBBS forum resource file service",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/cli/migrate.ts",
    "gc": "tsx src/cli/gc.ts",
    "integrity": "tsx src/cli/integrity.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "range-parser": "^1.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/range-parser": "^1.2.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
