NODE_ENV=development
PORT=5200
DATA_ROOT=./data
# Defaults to DATA_ROOT/resource-storage.sqlite when omitted.
# DATABASE_PATH=./data/resource-storage.sqlite

# Generate with: openssl rand -hex 32
RES_SERVICE_API_KEY=replace-with-at-least-32-random-bytes
# Optional. When absent, the service key also authorizes admin operations.
# RES_ADMIN_API_KEY=replace-with-a-different-random-key

PUBLIC_BASE_URL=https://res.mdtbbs.cn
MAX_OBJECT_SIZE=1073741824
UPLOAD_SESSION_TTL_SECONDS=900
PRIVATE_DOWNLOAD_TTL_SECONDS=300
GC_GRACE_DAYS=7
ACCESS_LOG_RETENTION_DAYS=210

# Exact origins that may use browser upload tokens and browser reads.
CORS_ALLOWED_ORIGINS=https://mdtbbs.cn,http://localhost:3000

# Only enable behind a trusted EdgeOne origin path. The origin firewall must
# prevent direct untrusted traffic from spoofing EO-Connecting-IP.
TRUST_EDGEONE=false
TRUST_PROXY_HOPS=1
